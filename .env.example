# -----------------------------------------------------------------------------
# Carrefour des Possibles — modèle de variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# NE JAMAIS versionner `.env.local` ni aucune vraie clé.
# Les variables préfixées NEXT_PUBLIC_ sont visibles dans le navigateur :
# n'y mettez jamais de secret.
# -----------------------------------------------------------------------------

# URL publique du site (sans barre finale). Sert aux métadonnées SEO et au sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ville par défaut (slug présent dans la table `cities`).
NEXT_PUBLIC_DEFAULT_CITY_SLUG=san-pedro

# --- Supabase (Paramètres du projet > API) -----------------------------------
# URL du projet, ex. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique : « publishable key » (sb_publishable_…) ou ancienne clé « anon ».
# Elle est protégée par les règles RLS de la base : elle peut être exposée.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : « secret key » (sb_secret_…) ou ancienne clé « service_role ».
# SERVEUR UNIQUEMENT. Contourne les règles RLS : à réserver aux webhooks de
# paiement et aux tâches d'administration.
SUPABASE_SECRET_KEY=

# --- Contact et réseaux sociaux (optionnels, affichés seulement si renseignés) --
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# --- Cartographie (phase 4) --------------------------------------------------
# Modèle d'URL des tuiles. Par défaut : OpenStreetMap (respecter sa politique
# d'usage ; prévoir un fournisseur de tuiles dédié si le trafic augmente).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© contributeurs OpenStreetMap

# --- Intelligence artificielle (serveur uniquement) --------------------------
# Fournisseur : none | anthropic | openai (couche de service interchangeable).
# Sans fournisseur, toutes les fonctions IA sont désactivées ; le site reste complet.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Plafond de dépense mensuel indicatif, en euros (coupe-circuit au niveau 23).
AI_MONTHLY_BUDGET_EUR=

# --- Paiements (serveur uniquement) ------------------------------------------
# Désactivés tant que les comptes marchands ne sont pas ouverts. Jamais simulés.
# Fournisseur : none | cinetpay | paydunya | wave | orange_money | mtn_momo
PAYMENT_PROVIDER=none
PAYMENT_API_KEY=
PAYMENT_SITE_ID=
PAYMENT_WEBHOOK_SECRET=

# --- E-mails et SMS (serveur uniquement) -------------------------------------
# E-mail : none | resend | smtp. Sans fournisseur, simulés dans la console en développement.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=
# SMS : none | twilio | orange
SMS_PROVIDER=none
SMS_API_KEY=

# --- Observabilité (serveur uniquement) --------------------------------------
# Niveau de journalisation : debug | info | warn | error
LOG_LEVEL=info
# DSN d'un service de suivi d'erreurs (Sentry ou équivalent), optionnel.
ERROR_TRACKING_DSN=
# Jeton d'accès à la page /interne/statut (24 caractères minimum).
# Sans jeton, la page n'est accessible qu'en développement.
INTERNAL_STATUS_TOKEN=

# --- Drapeaux de fonctionnalités (optionnels) --------------------------------
# on | off pour forcer ; vide = valeur par défaut (voir src/config/feature-flags.ts).
# Une fonctionnalité forcée à « on » reste inactive si son service n'est pas configuré.
FEATURE_ACCOUNTS=
FEATURE_PUBLISHING=
FEATURE_PRO_PUBLISHING=
FEATURE_MESSAGING=
FEATURE_REVIEWS=
FEATURE_MAP=
FEATURE_GEOLOCATION=
FEATURE_AI_SEARCH=
FEATURE_AI_ASSISTANT=
FEATURE_AI_PUBLISHING=
FEATURE_AI_MODERATION=
FEATURE_PAYMENTS=
FEATURE_EMAIL_NOTIFICATIONS=
FEATURE_PUSH_NOTIFICATIONS=
FEATURE_SMS=
FEATURE_MAINTENANCE=
